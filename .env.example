# Glasshouse — environment configuration
# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- HydraDB managed cloud (recall layer) ---
# Get from https://app.hydradb.com  (Ship tier: free, unlimited)
HYDRA_DB_API_KEY=

# --- Ollama Cloud (extraction + adjudication) ---
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com

# Models are selected in Session 0 by benchmarking; these are defaults.
OLLAMA_BULK_MODEL=
OLLAMA_ADJUDICATION_MODEL=

# --- HydraDB OSS engine (self-hosted, local) ---
# Local dev token, not a secret from anyone but your own machine.
HYDRA_LOCAL_TOKEN=local-development-token-32-bytes
HYDRA_BOLT_URI=neo4j://127.0.0.1:7687
HYDRA_HTTP_URI=http://127.0.0.1:8443
HYDRA_GRAPH_NAMESPACE=default
HYDRA_GRAPH_ID=default
HYDRA_GRAPH_CELL_ID=cell-0

# Held-out gold answers live outside the repo. Set this to your local path.
GOLD_ANSWERS_PATH=
